# Shared / Docker
POSTGRES_DB=ess
POSTGRES_USER=ess
POSTGRES_PASSWORD=ess_local_password
DATABASE_URL=postgresql+asyncpg://ess:ess_local_password@db:5432/ess
REDIS_URL=redis://redis:6379/0

# API
APP_NAME=Employee Self-Service Portal API
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://api:8000/api/v1
